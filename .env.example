# Discord bot token for the Locksmith application.
DISCORD_TOKEN=

# Optional: a home server that gets guild-scoped commands immediately.
# Global user-install commands are always registered for DMs and other servers.
GUILD_ID=1574583221243478156

# SQLite database. On Railway this lives on a mounted volume.
DATABASE_PATH=./data/locksmith.db

# 32-byte base64 or hex key for encrypting stored developer codes. Leave empty
# to generate <database dir>/locksmith.key with mode 0600.
STORE_KEY=

# ChastiSafe API root. Empty uses https://chastisafe.com/api-v1.
CHASTISAFE_BASE_URL=

# How often the notification scheduler wakes up.
NOTIFY_INTERVAL=30s

# How far ahead of a check-in to send the first reminder. The five minute
# reminder and the overdue reminder are always sent. Set 0 to disable only the
# early reminder.
CHECKIN_LEAD_TIME=1h

# Health server port.
PORT=8080

# debug, info, warn, error
LOG_LEVEL=info

# Anonymous usage statistics. Both must be set to enable tracking.
UMAMI_SITE_ID=
UMAMI_ENDPOINT=
